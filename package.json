{
  "name": "chat-adapter-chatwork",
  "version": "0.1.0-alpha.2",
  "description": "Chatwork adapter for Chat SDK",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepack": "npm run build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "chat-sdk",
    "chat-adapter",
    "chatwork",
    "bot",
    "webhook"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lifeprompt-team/chat-adapter-chatwork.git"
  },
  "bugs": {
    "url": "https://github.com/lifeprompt-team/chat-adapter-chatwork/issues"
  },
  "homepage": "https://github.com/lifeprompt-team/chat-adapter-chatwork#readme",
  "license": "MIT",
  "peerDependencies": {
    "chat": "^4.0.0"
  },
  "dependencies": {
    "@chat-adapter/shared": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "chat": "^4.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
